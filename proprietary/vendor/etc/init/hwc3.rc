service vendor.hwcomposer-3 /vendor/bin/hw/android.hardware.graphics.composer3-service.rtk
    class hal animation
    user system
    group graphics drmrpc media
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh HighPerformance

on property:sys.rtk.display.samescreen=*
    setprop vendor.rtk.display.samescreen ${sys.rtk.display.samescreen}